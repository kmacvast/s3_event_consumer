{
  "_comment": "Ready-to-run configuration for the local Docker Compose demo in docker/docker-compose.yml. The credentials below are that sandbox's throwaway MinIO defaults, on 127.0.0.1 only - see the security note in the compose file. For a real cluster, start from s3_consumer_config.example.json instead.",

  "kafka_config": {
    "bootstrap.servers": "localhost:19092",
    "group.id": "s3-event-iceberg-demo",
    "auto.offset.reset": "earliest",
    "broker.address.family": "v4"
  },
  "topic": "s3-events",

  "iceberg": {
    "enabled": true,
    "namespace": "s3_events",
    "table": "object_events",
    "batch_size": 25,
    "flush_interval_seconds": 5,
    "create_if_missing": true,
    "catalog": {
      "type": "rest",
      "uri": "http://localhost:8181",
      "warehouse": "s3://warehouse/",
      "s3.endpoint": "http://localhost:9000",
      "s3.access-key-id": "minioadmin",
      "s3.secret-access-key": "minioadmin",
      "s3.region": "us-east-1",
      "s3.path-style-access": true
    }
  }
}
