# VAST S3 -> Apache Iceberg customer demo: environment values.
#
#   cp docker/demo.env.example docker/demo.env
#   # edit docker/demo.env with your VAST values, then:
#   set -a; . ./docker/demo.env; set +a
#
# docker/demo.env is git-ignored. Never commit it, and never put real
# credentials in this example file.
#
# The same variables feed all three parts of the demo:
#   - the supporting containers   (docker/docker-compose.yml)
#   - the Python consumer         (via "env:NAME" references in its JSON config)
#   - the preflight and reset scripts
#
# Every value below must be collected from your VAST cluster. There are no
# sensible defaults for an endpoint or a credential, so the demo fails loudly
# and immediately rather than silently pointing somewhere wrong.

# --------------------------------------------------------------------------- #
# VAST S3
# --------------------------------------------------------------------------- #

# S3 endpoint URL for your VAST cluster, including scheme and, if non-standard,
# port. Normally https://. Take this from your VAST S3 VIP pool.
VAST_S3_ENDPOINT=https://<VAST_S3_VIP_OR_DNS_NAME>

# S3 access key pair for a VAST user that can read and write both buckets
# below. Create these on the VAST side; see the runbook's VAST preparation
# section. Treat this file as a secret once these are filled in.
VAST_S3_ACCESS_KEY=<VAST_S3_ACCESS_KEY>
VAST_S3_SECRET_KEY=<VAST_S3_SECRET_KEY>

# S3 clients require a region string even where the storage system does not use
# it to route. Leave as us-east-1 unless your VAST administrator specifies
# otherwise; it only has to be consistent across the consumer, the catalog and
# Trino.
VAST_S3_REGION=us-east-1

# The bucket the customer will write objects into during the demo. This is the
# bucket with the S3 event notification attached to it.
VAST_SOURCE_BUCKET=<VAST_DEMO_SOURCE_BUCKET>

# --------------------------------------------------------------------------- #
# VAST Kafka-compatible Event Broker
# --------------------------------------------------------------------------- #

# host:port list for the Event Broker VIPs. Take BOTH the addresses and the
# port from your VAST Event Broker configuration - this demo makes no
# assumption about which port your cluster uses.
VAST_KAFKA_BROKER=<KAFKA_VIP_1>:<KAFKA_PORT>,<KAFKA_VIP_2>:<KAFKA_PORT>

# The topic the S3 event notification publishes into, exactly as named in VAST.
VAST_KAFKA_TOPIC=<KAFKA_TOPIC>

# Consumer group. Kafka tracks the read position per group, so changing this
# replays the topic from the beginning - which is how you reset the demo
# without touching any data. See scripts/demo_reset.sh.
VAST_KAFKA_GROUP=vast-iceberg-demo

# --------------------------------------------------------------------------- #
# Apache Iceberg
# --------------------------------------------------------------------------- #

# The Iceberg warehouse: an s3:// URI naming a VAST S3 bucket that will hold
# the table's metadata and Parquet data files. This MUST be a different bucket
# from VAST_SOURCE_BUCKET - writing the warehouse into the watched bucket would
# make the demo generate events about itself, without end.
ICEBERG_WAREHOUSE=s3://<VAST_ICEBERG_WAREHOUSE_BUCKET>/

# Where the REST catalog listens. The containers reach it by service name; the
# consumer and the scripts reach it from the host.
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_CATALOG_URI_HOST=http://localhost:8181

# Namespace and table the consumer creates and Trino queries.
ICEBERG_NAMESPACE=s3_events
ICEBERG_TABLE=object_events

# --------------------------------------------------------------------------- #
# Demo host
# --------------------------------------------------------------------------- #

# Interface the supporting containers publish on. 127.0.0.1 keeps the whole
# demo on the loopback interface of the demo server, which is what you want
# when you are driving it yourself over SSH with port forwarding.
#
# Set this to 0.0.0.0 ONLY if a customer needs to reach SQLPad directly from
# their own browser - and re-enable SQLPad authentication first.
BIND_ADDRESS=127.0.0.1
